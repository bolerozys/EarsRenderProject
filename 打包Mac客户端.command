#!/usr/bin/env bash
# ============================================================================
#  双击这个文件，就能在 macOS 上生成可直接运行的客户端：
#
#      dist/PDF发票转图片.app      ← 双击运行（也可拖进“应用程序”）
#      dist/pdf2img                ← 命令行版
#
#  第一次使用：在“终端”里执行一次（赋予运行权限）
#      chmod +x "打包Mac客户端.command"
#  之后双击本文件即可；也可以直接在终端里运行：
#      bash "打包Mac客户端.command"
# ============================================================================
set -euo pipefail
cd "$(dirname "$0")"
exec bash packaging/build_macos.sh "$@"
